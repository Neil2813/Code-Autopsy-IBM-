# Application Configuration
APP_NAME="AI Legacy Modernization Copilot"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"

# Database Configuration
DATABASE_TYPE="postgresql"
DATABASE_URL="postgresql://user:password@localhost:5432/legacy_modernization"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""

# ============================================================================
# IBM watsonx.ai Configuration (PRIMARY LLM PROVIDER)
# ============================================================================
# Get your credentials from: https://cloud.ibm.com/
# 1. Create a watsonx.ai project
# 2. Generate an API key from IBM Cloud IAM
# 3. Copy your project ID from the project settings

# IBM watsonx.ai API Key (Required)
WATSONX_API_KEY="your-watsonx-api-key-here"

# IBM watsonx.ai Project ID (Required)
WATSONX_PROJECT_ID="your-project-id-here"

# IBM watsonx.ai URL (Default: US-South region)
# Available regions:
# - US-South: https://us-south.ml.cloud.ibm.com
# - EU-DE: https://eu-de.ml.cloud.ibm.com
# - JP-TOK: https://jp-tok.ml.cloud.ibm.com
WATSONX_URL="https://us-south.ml.cloud.ibm.com"

# IBM watsonx.ai Model (Default: Granite 13B Chat)
# Recommended models:
# - ibm/granite-13b-chat-v2 (Best for general chat and code understanding)
# - ibm/granite-20b-code-instruct (Best for code generation)
# - meta-llama/llama-2-70b-chat (Advanced reasoning)
# - ibm/granite-34b-code-instruct (Most powerful code model)
WATSONX_MODEL="ibm/granite-13b-chat-v2"

# ============================================================================
# OpenAI Configuration (SECONDARY/FALLBACK LLM PROVIDER)
# ============================================================================
# Used as fallback when watsonx.ai is unavailable
PRIMARY_LLM_PROVIDER="watsonx"
PRIMARY_LLM_MODEL="ibm/granite-13b-chat-v2"
PRIMARY_LLM_API_KEY="sk-your-openai-api-key-here"

# ============================================================================
# Groq Configuration (TERTIARY/FALLBACK LLM PROVIDER)
# ============================================================================
# Fast inference fallback provider
GROQ_LLM_API_KEY="your-groq-api-key-here"
GROQ_LLM_MODEL="mixtral-8x7b-32768"

# ============================================================================
# MCP (Model Context Protocol) Configuration
# ============================================================================
MCP_SERVER_PATH="./mcp_server"
MCP_DB_DSN="postgresql://user:password@localhost:5432/legacy_modernization"

# ============================================================================
# Storage Configuration
# ============================================================================
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
TEMP_DIR="./temp"
MAX_UPLOAD_SIZE_MB=100

# ============================================================================
# Security Configuration
# ============================================================================
# Generate a secure secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-secret-key-here-change-in-production"

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"

# ============================================================================
# Job Queue Configuration
# ============================================================================
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT_SECONDS=3600

# ============================================================================
# IBM watsonx Orchestrate Configuration (OPTIONAL)
# ============================================================================
# Uncomment and configure if using watsonx Orchestrate for workflow automation
# WATSONX_ORCHESTRATE_URL="https://orchestrate.automation.ibm.com"
# WATSONX_ORCHESTRATE_API_KEY="your-orchestrate-api-key"
# WATSONX_ORCHESTRATE_TENANT_ID="your-tenant-id"

# ============================================================================
# Advanced watsonx.ai Configuration (OPTIONAL)
# ============================================================================
# Fine-tune generation parameters
# WATSONX_TEMPERATURE=0.7
# WATSONX_MAX_TOKENS=2000
# WATSONX_TOP_P=1.0
# WATSONX_TOP_K=50
# WATSONX_REPETITION_PENALTY=1.0
# WATSONX_DECODING_METHOD="greedy"

# ============================================================================
# Development & Testing
# ============================================================================
# Set to true to enable detailed logging and debugging
# DEBUG=true

# Set to true to use mock providers for testing without API keys
# USE_MOCK_PROVIDERS=false

# ============================================================================
# Production Deployment Notes
# ============================================================================
# 1. Change all "your-*-here" values to actual credentials
# 2. Generate a new SECRET_KEY for production
# 3. Set DEBUG=false
# 4. Use strong database passwords
# 5. Configure proper CORS origins
# 6. Enable SSL/TLS for database connections
# 7. Set up proper logging and monitoring
# 8. Configure backup and disaster recovery
# 9. Review and apply security best practices
# 10. Test failover between LLM providers

# ============================================================================
# Quick Start Guide
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Get IBM watsonx.ai credentials:
#    - Go to https://cloud.ibm.com/
#    - Create a watsonx.ai project
#    - Generate API key from IAM
#    - Copy project ID
# 3. Update WATSONX_API_KEY and WATSONX_PROJECT_ID
# 4. Update DATABASE_URL with your PostgreSQL credentials
# 5. Generate and set SECRET_KEY
# 6. Run: python scripts/init_db.py
# 7. Start server: uvicorn app.main:app --reload
# 8. Test: curl http://localhost:8000/api/v1/health

# ============================================================================
# Support & Documentation
# ============================================================================
# - IBM watsonx.ai Docs: https://www.ibm.com/docs/en/watsonx-as-a-service
# - Project README: ../README.md
# - Integration Guide: ./IBM_BOB_INTEGRATION.md
# - API Documentation: http://localhost:8000/docs (when running)