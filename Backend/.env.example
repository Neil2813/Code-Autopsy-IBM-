# Application
APP_NAME=ai-legacy-modernization-copilot
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database (choose one)
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/legacy_copilot
# Or for SQLite:
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite:///./legacy_copilot.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# LLM Providers
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4
PRIMARY_LLM_API_KEY=sk-your-openai-key-here

GROQ_LLM_API_KEY=gsk_your-groq-key-here
GROQ_LLM_MODEL=mixtral-8x7b-32768

# MCP
MCP_SERVER_PATH=./mcp_server
MCP_DB_DSN=postgresql://user:password@localhost:5432/mcp_solutions

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_UPLOAD_SIZE_MB=100

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Job Queue
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT_SECONDS=3600